# Python
.venv/
.uv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime artifacts — mounted as a volume at runtime
out/
*.log

# Secrets — NEVER bake into the image
.env
.env.*
*.key
*.pem
*.crt

# Tests — not needed in the production image
tests/
test/

# Docs
docs/

# Flutter / mobile app — most of it isn't part of the backend image,
# but we DO need build/web/ so the API can serve the SPA at /app/*.
# Excluding `build/` outright blocks the `!` re-include (dockerignore
# inherits the gitignore "can't un-exclude under an excluded parent"
# rule), so we enumerate the build/ siblings instead.
lib/
android/
ios/
macos/
linux/
windows/
web/
pubspec.yaml
pubspec.lock
build/*.dill
build/*.json
build/app/
build/ios/
build/jni/
build/jni_flutter/
build/native_assets/
build/native_hooks/
build/reports/
build/test_cache/
build/unit_test_assets/
build/flutter_assets/
build/flutter_secure_storage/
build/sqflite_android/
build/video_player_android/
build/f*/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml
analysis_options.yaml

# Git
.git/
.gitignore

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Node (if any)
node_modules/

# Generated music (large binaries — mounted or re-created outside container)
assets/music/*.mp3

# Claude Code session state
.claude/

# Reference videos
Download.mp4
reference.mp4
*.reference.mp4
