# Multi-stage build for the Faceless marketing site.
#
# Stage 1 ("builder"): full Node image, runs `next build` which produces
# .next/standalone — a self-contained server bundle.
# Stage 2 ("runner"): slim Alpine image, ships only the standalone server,
# the static assets, and the public directory. ~150 MB final image.
#
# Build context is the website/ directory (use `gcloud builds submit
# --tag ... ./website` from the repo root, or `docker build` from inside
# the website/ folder).

FROM node:20-alpine AS builder
WORKDIR /app

# Copy lockfile + manifest first so the install layer caches across builds
# when only source changes.
COPY package.json package-lock.json* ./
RUN npm ci --prefer-offline --no-audit

COPY . .

# OG image generator fetches Google Fonts at build time — needs network.
# next build runs that fetch and bakes the resulting PNG into .next/.
RUN npm run build

# ---

FROM node:20-alpine AS runner
WORKDIR /app

# Standalone output ships everything required to serve. We add public/
# and .next/static manually because they're not auto-included in the
# standalone bundle (Next.js convention).
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Non-root user — Cloud Run accepts non-root, and it's cheap defense
# against accidental privileged operations in the container.
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

# server.js is generated by the standalone build. It listens on $PORT.
CMD ["node", "server.js"]
