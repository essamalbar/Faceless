# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.uv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime artifacts
out/
*.log

# Generated content history
story_history.jsonl
theme_log.json

# Local secrets
.env
*.local
*.key
*.pem
*.crt
# Tailscale-issued TLS certs/keys (cloudflared tunnel uses them locally)
*.ts.net.crt
*.ts.net.key

# Existing Flutter ignores (mirrors typical Flutter .gitignore — keep additive)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Claude Code session state
.claude/

# Generated music tracks (binaries — re-create via scripts/generate_placeholder_music.sh)
assets/music/*.mp3

# Local reference materials (e.g. downloaded TikTok videos used for style analysis)
Download.mp4
reference.mp4
*.reference.mp4

# local debug screenshots / user drops
/*.png
/ai song.mp4
