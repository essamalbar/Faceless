# Files in this list are NOT uploaded to Cloud Build.
# Keep upload tiny — only source the Dockerfile actually needs.

# Python venvs / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flutter build output (huge, irrelevant to backend image) — EXCEPT
# build/web/, which is the SPA bundle the Dockerfile copies into
# /app/static/web. gitignore rule: "you cannot re-include a file if
# the parent directory is excluded." So we exclude the CONTENTS of
# build/ pattern-by-pattern instead of the directory itself, leaving
# build/web/ visible to Cloud Build.
build/*.dill
build/*.json
build/app/
build/ios/
build/jni/
build/jni_flutter/
build/native_assets/
build/native_hooks/
build/reports/
build/test_cache/
build/unit_test_assets/
build/flutter_assets/
build/flutter_secure_storage/
build/sqflite_android/
build/video_player_android/
build/f*/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
ios/Pods/
android/.gradle/
macos/Pods/

# Run artifacts (videos, images, audio — generated locally)
out/
runs/
.cache/

# IDE / system
.idea/
.vscode/
.DS_Store
*.swp

# Git history (Cloud Build doesn't need it)
.git/
.gitignore

# Local env / secrets — secrets come from Secret Manager, not the image
.env
.env.*
*.crt
*.key

# Tailscale cert
giless-macbook-pro.tail*

# Docs / tests / scripts not needed in image
docs/
tests/
test/

# Marketing website — lives in its own Vercel deploy
website/

# Flutter platform scaffolds + plugin symlinks (only `lib/` matters, and even
# that isn't needed for the Python backend image — but keep it cheap)
android/
ios/
linux/
windows/
macos/

# Stray downloads at repo root
*.mp4
*.mov
*.mp3
*.wav
*.m4a
!assets/music/**
!assets/sfx/**

